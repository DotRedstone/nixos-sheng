From 97768cb3e47aa0eb0956b23a25e6600503f97aa3 Mon Sep 17 00:00:00 2001
From: DotRedstone <noreply@users.noreply.github.com>
Date: Sun, 11 Oct 2026 02:46:31 +0800
Subject: [PATCH] phy: qcom: add PM8550B eUSB2 repeater

---
 drivers/phy/qcom/Kconfig                   |   7 +
 drivers/phy/qcom/Makefile                  |   1 +
 drivers/phy/qcom/phy-qcom-eusb2-repeater.c | 159 +++++++++++++++++++++
 drivers/phy/qcom/phy-qcom-snps-eusb2.c     |  29 +++-
 4 files changed, 192 insertions(+), 4 deletions(-)
 create mode 100644 drivers/phy/qcom/phy-qcom-eusb2-repeater.c

diff --git a/drivers/phy/qcom/Kconfig b/drivers/phy/qcom/Kconfig
index 1fdadacc..54c7ccc0 100644
--- a/drivers/phy/qcom/Kconfig
+++ b/drivers/phy/qcom/Kconfig
@@ -55,6 +55,13 @@ config PHY_QCOM_SNPS_EUSB2
 	  High-Speed PHY driver. This driver supports the Hi-Speed PHY which
 	  is usually paired with Synopsys DWC3 USB IPs on MSM SOCs.
 
+config PHY_QCOM_EUSB2_REPEATER
+	bool "Qualcomm PM8550B eUSB2 repeater"
+	depends on PHY && ARCH_SNAPDRAGON && DM_REGULATOR && PMIC_QCOM
+	help
+	  Enable support for the PM8550B eUSB2 repeater used between the SoC
+	  eUSB2 PHY and the USB2 connector on supported Snapdragon platforms.
+
 config PHY_QCOM_USB_HS_28NM
 	bool "Qualcomm 28nm High-Speed PHY"
 	depends on PHY && ARCH_SNAPDRAGON
diff --git a/drivers/phy/qcom/Makefile b/drivers/phy/qcom/Makefile
index 714013dc..4994a695 100644
--- a/drivers/phy/qcom/Makefile
+++ b/drivers/phy/qcom/Makefile
@@ -6,5 +6,6 @@ obj-$(CONFIG_PHY_QCOM_QMP_UFS) += phy-qcom-qmp-ufs.o
 obj-$(CONFIG_PHY_QCOM_QUSB2) += phy-qcom-qusb2.o
 obj-$(CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2) += phy-qcom-snps-femto-v2.o
 obj-$(CONFIG_PHY_QCOM_SNPS_EUSB2) += phy-qcom-snps-eusb2.o
+obj-$(CONFIG_PHY_QCOM_EUSB2_REPEATER) += phy-qcom-eusb2-repeater.o
 obj-$(CONFIG_PHY_QCOM_USB_HS_28NM) += phy-qcom-usb-hs-28nm.o
 obj-$(CONFIG_PHY_QCOM_USB_SS) += phy-qcom-usb-ss.o
diff --git a/drivers/phy/qcom/phy-qcom-eusb2-repeater.c b/drivers/phy/qcom/phy-qcom-eusb2-repeater.c
new file mode 100644
index 00000000..b44bc2a3
--- /dev/null
+++ b/drivers/phy/qcom/phy-qcom-eusb2-repeater.c
@@ -0,0 +1,159 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright (c) 2026, DotRedstone
+ *
+ * PM8550B eUSB2 repeater support for U-Boot.  The register sequence and
+ * supply requirements follow the Linux PM8550B eUSB2 repeater driver.
+ */
+
+#include <dm.h>
+#include <dm/device_compat.h>
+#include <generic-phy.h>
+#include <linux/bitops.h>
+#include <linux/delay.h>
+#include <power/pmic.h>
+#include <power/regulator.h>
+
+#define EUSB2_RPTR_STATUS	0x08
+#define EUSB2_RPTR_OK		BIT(7)
+
+#define EUSB2_EN_CTL1		0x46
+#define EUSB2_RPTR_EN		BIT(7)
+
+#define EUSB2_FORCE_EN_5	0xe8
+#define EUSB2_FORCE_VAL_5	0xed
+#define EUSB2_CLK_19P2M_EN	BIT(6)
+
+#define EUSB2_TUNE_IUSB2	0x51
+#define EUSB2_TUNE_SQUELCH_U	0x54
+#define EUSB2_TUNE_USB2_PREEM	0x57
+
+struct qcom_eusb2_repeater_priv {
+	u32 base;
+	struct udevice *vdd18;
+	struct udevice *vdd3;
+};
+
+static int qcom_eusb2_repeater_init(struct phy *phy)
+{
+	struct qcom_eusb2_repeater_priv *priv = dev_get_priv(phy->dev);
+	struct udevice *dev = phy->dev;
+	int ret;
+	int status;
+	int i;
+
+	ret = regulator_set_enable(priv->vdd18, true);
+	if (ret)
+		return ret;
+
+	ret = regulator_set_enable(priv->vdd3, true);
+	if (ret)
+		goto disable_vdd18;
+
+	ret = pmic_clrsetbits(dev->parent, priv->base + EUSB2_EN_CTL1,
+			      0, EUSB2_RPTR_EN);
+	if (ret)
+		goto disable_vdd3;
+
+	ret = pmic_reg_write(dev->parent, priv->base + EUSB2_TUNE_IUSB2, 0x8);
+	if (ret)
+		goto disable_vdd3;
+	ret = pmic_reg_write(dev->parent, priv->base + EUSB2_TUNE_SQUELCH_U, 0x3);
+	if (ret)
+		goto disable_vdd3;
+	ret = pmic_reg_write(dev->parent, priv->base + EUSB2_TUNE_USB2_PREEM, 0x5);
+	if (ret)
+		goto disable_vdd3;
+
+	for (i = 0; i < 500; i++) {
+		status = pmic_reg_read(dev->parent, priv->base + EUSB2_RPTR_STATUS);
+		if (status < 0) {
+			ret = status;
+			goto disable_vdd3;
+		}
+		if (status & EUSB2_RPTR_OK)
+			return 0;
+		udelay(10);
+	}
+
+	ret = -ETIMEDOUT;
+
+disable_vdd3:
+	regulator_set_enable(priv->vdd3, false);
+disable_vdd18:
+	regulator_set_enable(priv->vdd18, false);
+	return ret;
+}
+
+static int qcom_eusb2_repeater_exit(struct phy *phy)
+{
+	struct qcom_eusb2_repeater_priv *priv = dev_get_priv(phy->dev);
+	int ret;
+
+	ret = regulator_set_enable(priv->vdd3, false);
+	if (ret)
+		return ret;
+
+	return regulator_set_enable(priv->vdd18, false);
+}
+
+static int qcom_eusb2_repeater_set_mode(struct phy *phy, enum phy_mode mode,
+					int submode)
+{
+	struct qcom_eusb2_repeater_priv *priv = dev_get_priv(phy->dev);
+	struct udevice *dev = phy->dev;
+	int ret;
+
+	switch (mode) {
+	case PHY_MODE_USB_HOST:
+		ret = pmic_reg_write(dev->parent, priv->base + EUSB2_FORCE_EN_5,
+				     EUSB2_CLK_19P2M_EN);
+		if (ret)
+			return ret;
+		return pmic_reg_write(dev->parent, priv->base + EUSB2_FORCE_VAL_5,
+				      EUSB2_CLK_19P2M_EN);
+	case PHY_MODE_USB_DEVICE:
+		ret = pmic_reg_write(dev->parent, priv->base + EUSB2_FORCE_EN_5, 0);
+		if (ret)
+			return ret;
+		return pmic_reg_write(dev->parent, priv->base + EUSB2_FORCE_VAL_5, 0);
+	default:
+		return -EINVAL;
+	}
+}
+
+static int qcom_eusb2_repeater_probe(struct udevice *dev)
+{
+	struct qcom_eusb2_repeater_priv *priv = dev_get_priv(dev);
+	int ret;
+
+	ret = dev_read_u32(dev, "reg", &priv->base);
+	if (ret)
+		return ret;
+
+	ret = device_get_supply_regulator(dev, "vdd18-supply", &priv->vdd18);
+	if (ret)
+		return ret;
+
+	return device_get_supply_regulator(dev, "vdd3-supply", &priv->vdd3);
+}
+
+static const struct phy_ops qcom_eusb2_repeater_ops = {
+	.init = qcom_eusb2_repeater_init,
+	.exit = qcom_eusb2_repeater_exit,
+	.set_mode = qcom_eusb2_repeater_set_mode,
+};
+
+static const struct udevice_id qcom_eusb2_repeater_ids[] = {
+	{ .compatible = "qcom,pm8550b-eusb2-repeater" },
+	{ }
+};
+
+U_BOOT_DRIVER(qcom_eusb2_repeater) = {
+	.name = "qcom-pm8550b-eusb2-repeater",
+	.id = UCLASS_PHY,
+	.of_match = qcom_eusb2_repeater_ids,
+	.ops = &qcom_eusb2_repeater_ops,
+	.probe = qcom_eusb2_repeater_probe,
+	.priv_auto = sizeof(struct qcom_eusb2_repeater_priv),
+};
diff --git a/drivers/phy/qcom/phy-qcom-snps-eusb2.c b/drivers/phy/qcom/phy-qcom-snps-eusb2.c
index 28502c46..bc8a6327 100644
--- a/drivers/phy/qcom/phy-qcom-snps-eusb2.c
+++ b/drivers/phy/qcom/phy-qcom-snps-eusb2.c
@@ -126,6 +126,7 @@ struct qcom_snps_eusb2_phy_priv {
 	void __iomem *base;
 	struct clk *ref_clk;
 	struct reset_ctl_bulk resets;
+	struct phy repeater;
 };
 
 static void qcom_snps_eusb2_hsphy_write_mask(void __iomem *base, u32 offset,
@@ -295,19 +296,33 @@ static int qcom_snps_eusb2_phy_power_on(struct phy *phy)
 	struct qcom_snps_eusb2_phy_priv *qcom_snps_eusb2 = dev_get_priv(phy->dev);
 	int ret;
 
-	/* TODO Repeater */
+	ret = generic_phy_init(&qcom_snps_eusb2->repeater);
+	if (ret)
+		return ret;
+
+	ret = generic_phy_set_mode(&qcom_snps_eusb2->repeater, PHY_MODE_USB_DEVICE, 0);
+	if (ret)
+		goto exit_repeater;
 
 	clk_prepare_enable(qcom_snps_eusb2->ref_clk);
 
 	ret = reset_deassert_bulk(&qcom_snps_eusb2->resets);
 	if (ret)
-		return ret;
+		goto disable_clk;
 
 	ret = qcom_snps_eusb2_usb_init(phy);
 	if (ret)
-		return ret;
+		goto assert_reset;
 
 	return 0;
+
+assert_reset:
+	reset_assert_bulk(&qcom_snps_eusb2->resets);
+disable_clk:
+	clk_disable_unprepare(qcom_snps_eusb2->ref_clk);
+exit_repeater:
+	generic_phy_exit(&qcom_snps_eusb2->repeater);
+	return ret;
 }
 
 static int qcom_snps_eusb2_phy_power_off(struct phy *phy)
@@ -317,7 +332,7 @@ static int qcom_snps_eusb2_phy_power_off(struct phy *phy)
 	reset_assert_bulk(&qcom_snps_eusb2->resets);
 	clk_disable_unprepare(qcom_snps_eusb2->ref_clk);
 
-	return 0;
+	return generic_phy_exit(&qcom_snps_eusb2->repeater);
 }
 
 static int qcom_snps_eusb2_phy_probe(struct udevice *dev)
@@ -342,6 +357,12 @@ static int qcom_snps_eusb2_phy_probe(struct udevice *dev)
 		return ret;
 	}
 
+	ret = generic_phy_get_by_index(dev, 0, &qcom_snps_eusb2->repeater);
+	if (ret) {
+		printf("failed to get eUSB2 repeater, ret = %d\n", ret);
+		return ret;
+	}
+
 	return 0;
 }
 
-- 
