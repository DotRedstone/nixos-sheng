From: NixOS Android devices contributors <nixos-android-devices@localhost>
Date: Mon, 28 Sep 2026 21:00:00 +0800
Subject: [PATCH] clk: qcom: program SM8550 UFS UniPro clock

Local adaptation of the Linux SM8550 frequency table and RCGR offset:
https://github.com/ianchb/sm8550-mainline/blob/ad75da348a020f0b7cb541ca2f06ab38cf77004d/drivers/clk/qcom/gcc-sm8550.c

U-Boot ufs-qcom sets core_clk_unipro and requires a positive rate result.
The shared baseline lacks this case. Keep firmware at the existing DT
maximum of 300 MHz and leave PLL initialization to ABL.
---
diff --git a/drivers/clk/qcom/clock-sm8550.c b/drivers/clk/qcom/clock-sm8550.c
--- a/drivers/clk/qcom/clock-sm8550.c
+++ b/drivers/clk/qcom/clock-sm8550.c
@@ -67,12 +67,26 @@
 	{ }
 };
 
+/* Linux gcc-sm8550.c: GPLL0 600 MHz, even output 300 MHz. */
+static const struct freq_tbl ftbl_ufs_unipro[] = {
+	F(75000000, CFG_CLK_SRC_GPLL0_EVEN, 4, 0, 0),
+	F(150000000, CFG_CLK_SRC_GPLL0, 4, 0, 0),
+	F(300000000, CFG_CLK_SRC_GPLL0, 2, 0, 0),
+	{ }
+};
+
 static ulong sm8550_set_rate(struct clk *clk, ulong rate)
 {
 	struct msm_clk_priv *priv = dev_get_priv(clk->dev);
 	const struct freq_tbl *freq;
 
 	switch (clk->id) {
+	case GCC_UFS_PHY_UNIPRO_CORE_CLK:
+		if (rate > 300000000)
+			return -EINVAL;
+		freq = qcom_find_freq(ftbl_ufs_unipro, rate);
+		clk_rcg_set_rate(priv->base, 0x77098, freq->pre_div, freq->src);
+		return freq->freq;
 	case GCC_QUPV3_WRAP1_S7_CLK: /* UART7 */
 		freq = qcom_find_freq(ftbl_gcc_qupv3_wrap1_s2_clk_src, rate);
 		clk_rcg_set_rate_mnd(priv->base, 0x18898,
