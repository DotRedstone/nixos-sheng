From: Sheng EFI experiment <noreply@example.invalid>
Subject: [PATCH] efi: blank inherited video before ExitBootServices teardown

Write black to the inherited simple framebuffer and wait for scanout before
turning devices over to Linux. This is a diagnostic for the one-frame flash
on Sheng; the deliberate 50 ms blank must not become a stable default without
visual device validation.

---
 lib/efi_loader/efi_boottime.c | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

--- a/lib/efi_loader/efi_boottime.c
+++ b/lib/efi_loader/efi_boottime.c
@@ -11,6 +11,7 @@
 #include <div64.h>
 #include <dm/device.h>
 #include <dm/root.h>
+#include <dm/uclass-internal.h>
 #include <efi_device_path.h>
 #include <efi_loader.h>
 #include <irq_func.h>
@@ -21,8 +22,10 @@
 #include <time.h>
 #include <u-boot/crc.h>
 #include <usb.h>
+#include <video.h>
 #include <watchdog.h>
 #include <asm/global_data.h>
+#include <linux/delay.h>
 #include <linux/libfdt_env.h>
 
 DECLARE_GLOBAL_DATA_PTR;
@@ -2241,6 +2244,16 @@
 	}
 
 	if (!efi_st_keep_devices) {
+		struct udevice *video_dev;
+
+		/* Diagnostic: leave a black scanout before the Linux display handoff. */
+		uclass_find_first_device(UCLASS_VIDEO, &video_dev);
+		if (video_dev) {
+			video_fill(video_dev, 0);
+			video_sync(video_dev, true);
+			mdelay(50);
+		}
+
 		bootm_disable_interrupts();
 		if (IS_ENABLED(CONFIG_DM_ETH))
 			eth_halt();
