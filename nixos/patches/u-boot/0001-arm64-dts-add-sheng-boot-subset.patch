From: DotRedstone <noreply@users.noreply.github.com>
Subject: [PATCH] arm64: dts: add Xiaomi Pad 6S Pro boot subset

Add only the board description needed for a future RAM-boot experiment:
board identity, power/volume recovery inputs, UFS reset, USB2 gadget wiring,
and reserved ABL memory.  This is intentionally not a full Linux hardware DTS.

Source: DotRedstone/linux-sheng commit c4b27e2cec1371e166f443877812639d4d0d33da,
arch/arm64/boot/dts/qcom/sm8550-xiaomi-sheng.dts (BSD-3-Clause, map220v).
The subset is independently transcribed from that source for U-Boot. It keeps
only the PM8550B RPMh regulator entries needed by the eUSB2 repeater; ABL owns
the remaining regulator votes and display initialization.

Signed-off-by: DotRedstone <noreply@users.noreply.github.com>
---
 dts/upstream/src/arm64/qcom/sm8550-xiaomi-sheng.dts | 135 +++++++++++++++++++++++
 1 file changed, 135 insertions(+)

diff --git a/dts/upstream/src/arm64/qcom/sm8550-xiaomi-sheng.dts b/dts/upstream/src/arm64/qcom/sm8550-xiaomi-sheng.dts
new file mode 100644
index 000000000000..bbbbbbbbbbbb
--- /dev/null
+++ b/dts/upstream/src/arm64/qcom/sm8550-xiaomi-sheng.dts
@@ -0,0 +1,135 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Copyright (c) 2024, map220v <map220v300@gmail.com>
+ *
+ * Minimal U-Boot boot subset independently derived from the Sheng Linux DTS.
+ * ABL retains ownership of regulator votes and display initialization.
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/linux-event-codes.h>
+#include "sm8550.dtsi"
+#include "pm8550.dtsi"
+#include "pm8550b.dtsi"
+#include "pmk8550.dtsi"
+
+/ {
+	model = "Xiaomi Pad 6S Pro 12.4";
+	compatible = "xiaomi,sheng", "qcom,sm8550";
+	qcom,msm-id = <536 0x20000>;
+	qcom,board-id = <0x10008 0>;
+
+	aliases {
+		serial0 = &uart7;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+		pinctrl-names = "default";
+		pinctrl-0 = <&sheng_volume_up>;
+
+		volume-up {
+			label = "Volume Up";
+			linux,code = <KEY_VOLUMEUP>;
+			gpios = <&pm8550_gpios 6 GPIO_ACTIVE_LOW>;
+		};
+	};
+
+	reserved-memory {
+		ranges;
+
+		/* ABL may retain this splash area even when U-Boot does not display it. */
+		abl_splash: splash@b8000000 {
+			reg = <0 0xb8000000 0 0x02b00000>;
+			no-map;
+		};
+
+		xbl_ramdump: ramdump@81200000 {
+			reg = <0 0x81200000 0 0x00280000>;
+			no-map;
+		};
+
+		xbl_dt_log: dt-log@81a00000 {
+			reg = <0 0x81a00000 0 0x00040000>;
+			no-map;
+		};
+
+		aop_image: aop-image@81c00000 {
+			reg = <0 0x81c00000 0 0x00060000>;
+			no-map;
+		};
+	};
+};
+
+&pm8550_gpios {
+	sheng_volume_up: sheng-volume-up-state {
+		pins = "gpio6";
+		function = "normal";
+		power-source = <1>;
+		bias-pull-up;
+		input-enable;
+	};
+};
+
+&pon_pwrkey {
+	status = "okay";
+};
+
+&pon_resin {
+	linux,code = <KEY_VOLUMEDOWN>;
+	status = "okay";
+};
+
+&ufs_mem_hc {
+	reset-gpios = <&tlmm 210 GPIO_ACTIVE_LOW>;
+	status = "okay";
+};
+
+&ufs_mem_phy {
+	status = "okay";
+};
+
+&apps_rsc {
+	/* Only the two rails directly consumed by the PM8550B eUSB2 repeater. */
+	sheng_eusb2_regulators: regulators-sheng-eusb2 {
+		compatible = "qcom,pm8550-rpmh-regulators";
+		qcom,pmic-id = "b";
+
+		vreg_l5b_3p1: ldo5 {
+			regulator-name = "vreg_l5b_3p1";
+			regulator-min-microvolt = <3104000>;
+			regulator-max-microvolt = <3104000>;
+		};
+
+		vreg_l15b_1p8: ldo15 {
+			regulator-name = "vreg_l15b_1p8";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+		};
+	};
+};
+
+&pm8550b_eusb2_repeater {
+	vdd18-supply = <&vreg_l15b_1p8>;
+	vdd3-supply = <&vreg_l5b_3p1>;
+	status = "okay";
+};
+
+&usb_1_hsphy {
+	phys = <&pm8550b_eusb2_repeater>;
+	status = "okay";
+};
+
+&usb_1 {
+	phys = <&usb_1_hsphy>;
+	phy-names = "usb2-phy";
+	dr_mode = "peripheral";
+	maximum-speed = "high-speed";
+	status = "okay";
+};
