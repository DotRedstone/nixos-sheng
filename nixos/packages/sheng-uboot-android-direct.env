# SPDX-License-Identifier: GPL-2.0+
# RAM 启动探针：B 槽 U-Boot 只读 A 槽 Android 启动分区。
# 本机 UFS 逻辑块为 4096 字节。固定读取上限只适用于当前已检查的镜像。
bootdelay=0
bootretry=1
stdin=serial,button-kbd
stdout=serial
stderr=serial
serial_gadget=setenv stdin serial,button-kbd,usbacm; \
	setenv stdout serial,usbacm; \
	setenv stderr serial,usbacm; \
	setenv bootretry -1
preboot=run serial_gadget; setenv android_buf_base ${ramdisk_addr_r}; scsi scan; \
	for bootdev in 0 1 2 3 4 5 6 7; do \
		if part number scsi ${bootdev} linux-boot android_esp_part; then \
			setenv android_esp_dev ${bootdev}; break; \
		fi; \
	done

# 阶段标记仅用于 RAM 测试，写到项目自有 ESP，供失败后在 NixOS 读取。
android_mark=echo Android probe: ${android_stage}; \
if env export -t ${scriptaddr} android_stage; then \
	fatwrite scsi ${android_esp_dev}:${android_esp_part} ${scriptaddr} PROBE.TXT ${filesize}; \
fi

# Qualcomm 的 UFS LUN 在 U-Boot 中按 scsi 设备枚举。
android_find=setenv android_stage find_partitions; run android_mark; \
for bootdev in 0 1 2 3 4 5 6 7; do \
	if part start scsi ${bootdev} boot_a android_boot_start; then \
		setenv android_dev ${bootdev}; break; \
	fi; \
done; \
part start scsi ${android_dev} vendor_boot_a android_vendor_start && \
part start scsi ${android_dev} init_boot_a android_init_start && \
part start scsi ${android_dev} dtbo_a android_dtbo_start && \
scsi device ${android_dev}

# loadaddr 是独立的 fastboot 缓冲区。当前 A 槽 boot v4 的内核在镜像头后
# 0x1000 字节，Image 的 text_offset 为 0；把镜像头放在 2 MiB 边界前
# 0x1000 字节，确保 U-Boot 原地执行的内核满足 ARM64 启动对齐要求。
# ramdisk_addr_r 的 128 MiB 区域
# 依次容纳 vendor_boot、init_boot、dtbo 和 bootm 合成的 ramdisk。
# 64/48/8/16 MiB 读取长度覆盖当前镜像有效数据，不覆盖整个分区。
android_load_setup=setenv android_stage memory_layout; run android_mark; \
setexpr android_boot_addr ${loadaddr} + 0x1ff000 && \
setexpr android_vendor_addr ${android_buf_base} + 0x0 && \
setexpr android_init_addr ${android_buf_base} + 0x3000000 && \
setexpr android_dtbo_addr ${android_buf_base} + 0x3800000 && \
setexpr ramdisk_addr_r ${android_buf_base} + 0x4800000
android_load_boot=setenv android_stage read_boot; run android_mark; \
	scsi read ${android_boot_addr} ${android_boot_start} 0x4000
android_load_vendor=setenv android_stage read_vendor_boot; run android_mark; \
	scsi read ${android_vendor_addr} ${android_vendor_start} 0x3000
android_load_init=setenv android_stage read_init_boot; run android_mark; \
	scsi read ${android_init_addr} ${android_init_start} 0x800
android_load_dtbo=setenv android_stage read_dtbo; run android_mark; \
	scsi read ${android_dtbo_addr} ${android_dtbo_start} 0x1000
android_snapshot=fatwrite scsi ${android_esp_dev}:${android_esp_part} ${android_boot_addr} BHEAD.BIN 0x1000; \
	fatwrite scsi ${android_esp_dev}:${android_esp_part} ${android_vendor_addr} VHEAD.BIN 0x1000
android_load=run android_load_setup && run android_load_boot && \
	run android_load_vendor && run android_load_init && run android_load_dtbo

# 原生 Android 报告 vendor_boot DTB 6、dtbo_a 覆盖层 47。
android_parse_addr=setenv android_stage abootimg_addr; run android_mark; \
	abootimg addr ${android_boot_addr} ${android_vendor_addr} ${android_init_addr} && \
	abootimg get ver android_boot_version
android_parse_dtb=setenv android_stage abootimg_dtb; run android_mark; \
	abootimg get dtb --index=6 android_dtb_addr android_dtb_size
android_parse=run android_parse_addr && run android_parse_dtb
android_prepare_dtb=setenv android_stage prepare_dtb; run android_mark; \
	cp.b ${android_dtb_addr} ${fdt_addr_r} ${android_dtb_size} && \
	fdt addr ${fdt_addr_r} 0x200000
android_apply_dtbo=setenv android_stage apply_dtbo; run android_mark; \
	adtimg addr ${android_dtbo_addr} && \
	adtimg get dt --index=47 android_overlay_addr android_overlay_size && \
	fdt apply ${android_overlay_addr}
android_bootm_start=setenv android_stage bootm_start; run android_mark; \
	bootm start ${android_boot_addr} ${android_boot_addr} ${fdt_addr_r}
android_bootm_loados=setenv android_stage bootm_loados; run android_mark; bootm loados
android_bootm_ramdisk=setenv android_stage bootm_ramdisk; run android_mark; bootm ramdisk
android_bootm_fdt=setenv android_stage bootm_fdt; run android_mark; bootm fdt
android_bootm_prep=setenv android_stage bootm_prep; run android_mark; bootm prep
android_save_bootargs=if env export -t ${scriptaddr} bootargs; then \
	fatwrite scsi ${android_esp_dev}:${android_esp_part} ${scriptaddr} BOOTARGS.TXT ${filesize}; \
fi
android_bootm_go=setenv android_stage bootm_go; run android_mark; bootm go; \
	setenv android_stage bootm_go_returned; run android_mark
android_bootm=fdt get value android_dtb_bootargs /chosen bootargs && \
	setenv bootargs ${android_dtb_bootargs} androidboot.slot_suffix=_a androidboot.hardware=qcom androidboot.boot_devices=soc/1d84000.ufshc androidboot.bootdevice=1d84000.ufshc androidboot.dynamic_partitions=true androidboot.fstab_suffix=default && \
	run android_bootm_start && run android_bootm_loados && \
	run android_bootm_ramdisk && run android_bootm_fdt && \
	run android_bootm_prep && run android_save_bootargs && run android_bootm_go
android_handoff=run android_parse && run android_prepare_dtb && \
	run android_apply_dtbo && run android_bootm

boot_android_a=if run android_find && run android_load; then \
	run android_snapshot; run android_handoff; \
fi

boot_linux=for bootdev in 0 1 2 3 4 5 6 7; do if part number scsi ${bootdev} linux-boot bootpart; then if fatload scsi ${bootdev}:${bootpart} ${kernel_addr_r} /EFI/BOOT/BOOTAA64.EFI; then setenv stdout vidconsole,serial,usbacm; setenv stderr vidconsole,serial,usbacm; bootefi ${kernel_addr_r}; fi; fi; done
bootcmd=run boot_android_a; reset
menucmd=setenv stdout vidconsole,serial,usbacm; \
	setenv stderr vidconsole,serial,usbacm; \
	setenv bootcmd run menucmd; bootmenu -1
bootmenu_0=Boot NixOS=run boot_linux; pause
bootmenu_1=Boot Android A directly (experimental)=run boot_android_a; pause
bootmenu_2=Drop to shell=setenv bootretry -1
bootmenu_3=Reset device=reset
button_cmd_0_name=Volume Down
button_cmd_0=run menucmd
