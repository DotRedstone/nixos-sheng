# SPDX-License-Identifier: GPL-2.0+
# 实验性双系统菜单：B 槽 U-Boot 只读 A 槽 Android 启动分区。
# 启动参数由 Android A 槽实机采集，缺少配置时拒绝直启。
bootdelay=0
bootretry=1
stdin=serial,button-kbd
stdout=serial
stderr=serial
serial_gadget=setenv stdin serial,button-kbd,usbacm; \
	setenv stdout serial,usbacm; \
	setenv stderr serial,usbacm; \
	setenv bootretry -1
preboot=run serial_gadget; scsi scan; \
	for bootdev in 0 1 2 3 4 5 6 7; do \
		if part number scsi ${bootdev} linux-boot android_esp_part; then \
			setenv android_esp_dev ${bootdev}; break; \
		fi; \
	done

android_config_load=setenv android_profile_version; setenv android_profile_board; \
	setenv android_profile_slot; setenv android_boot_devices; \
	setenv android_bootdevice; setenv android_fstab_suffix; \
	setenv android_dynamic_partitions; setenv android_verifiedbootstate; \
	fatload scsi ${android_esp_dev}:${android_esp_part} ${scriptaddr} /SHENG/ANDROID.ENV && \
	env import -t ${scriptaddr} ${filesize} android_profile_version android_profile_board android_profile_slot android_boot_devices android_bootdevice android_fstab_suffix android_dynamic_partitions android_verifiedbootstate
android_config_check=test "${android_profile_version}" = 1 && test "${android_profile_board}" = sheng && \
	test "${android_profile_slot}" = _a && test "${android_verifiedbootstate}" = orange && \
	test -n "${android_boot_devices}" && test -n "${android_bootdevice}" && \
	test -n "${android_fstab_suffix}" && test "${android_dynamic_partitions}" = true

# 启动阶段仅输出到控制台，日常选择 Android 时不写 ESP。
android_mark=echo Android probe: ${android_stage}

# Qualcomm 的 UFS LUN 在 U-Boot 中按 scsi 设备枚举。
android_find=setenv android_stage find_partitions; run android_mark; \
for bootdev in 0 1 2 3 4 5 6 7; do \
	if part start scsi ${bootdev} boot_a android_boot_start; then \
		setenv android_dev ${bootdev}; break; \
	fi; \
done; \
part start scsi ${android_dev} vendor_boot_a android_vendor_start && \
part start scsi ${android_dev} init_boot_a android_init_start && \
part start scsi ${android_dev} dtbo_a android_dtbo_start && \
part size scsi ${android_dev} boot_a android_boot_partition_blocks && \
part size scsi ${android_dev} vendor_boot_a android_vendor_partition_blocks && \
part size scsi ${android_dev} init_boot_a android_init_partition_blocks && \
part size scsi ${android_dev} dtbo_a android_dtbo_partition_blocks && \
itest ${android_boot_partition_blocks} -ge 0x4000 && \
itest ${android_vendor_partition_blocks} -ge 0x3000 && \
itest ${android_init_partition_blocks} -ge 0x800 && \
itest ${android_dtbo_partition_blocks} -ge 0x1000 && \
setenv android_boot_blocks 0x4000 && \
setenv android_vendor_blocks 0x3000 && \
setenv android_init_blocks 0x800 && \
setenv android_dtbo_blocks 0x1000 && \
scsi device ${android_dev}

# ABL 传入的设备树确认 0xa7fff000..0xb3800000 属于 RAM，且不与
# reserved-memory 的已定址区域重叠。低地址布局用于验证 Android 内核
# 是否要求 ABL 常用的 4 GiB 以下装载；只用于 RAM 探针。
# 当前 boot v4 的内核在镜像头后 0x1000 字节，text_offset 为 0。
# 安装脚本依据镜像头确认有效数据落在固定读取窗口内。这里再检查
# 分区至少覆盖该窗口，避免读越界或相邻缓冲区重叠。
android_load_setup=setenv android_stage memory_layout; run android_mark; \
setenv android_boot_addr 0xa7fff000 && \
setenv android_vendor_addr 0xac000000 && \
setenv android_init_addr 0xaf000000 && \
setenv android_dtbo_addr 0xaf800000 && \
setenv ramdisk_addr_r 0xb0800000 && \
setenv initrd_high 0xffffffffffffffff && \
setenv fdt_addr_r 0xb4000000 && \
setenv fdt_high 0xffffffffffffffff
android_load_boot=setenv android_stage read_boot; run android_mark; \
	scsi read ${android_boot_addr} ${android_boot_start} ${android_boot_blocks}
android_load_vendor=setenv android_stage read_vendor_boot; run android_mark; \
	scsi read ${android_vendor_addr} ${android_vendor_start} ${android_vendor_blocks}
android_load_init=setenv android_stage read_init_boot; run android_mark; \
	scsi read ${android_init_addr} ${android_init_start} ${android_init_blocks}
android_load_dtbo=setenv android_stage read_dtbo; run android_mark; \
	scsi read ${android_dtbo_addr} ${android_dtbo_start} ${android_dtbo_blocks}
android_load=run android_load_setup && run android_load_boot && \
	run android_load_vendor && run android_load_init && run android_load_dtbo

android_parse_addr=setenv android_stage abootimg_addr; run android_mark; \
	abootimg addr ${android_boot_addr} ${android_vendor_addr} ${android_init_addr} && \
	abootimg get ver android_boot_version
android_version_check=test "${android_boot_version}" = 4
android_parse=run android_parse_addr && run android_version_check
android_prepare_dtb=setenv android_stage prepare_dtb; run android_mark; \
	fdt addr ${prevbl_fdt_addr} && \
	fdt get value android_dtb_bootargs /chosen bootargs && \
	cp.b ${prevbl_fdt_addr} ${fdt_addr_r} 0x100000 && \
	fdt addr ${fdt_addr_r} 0x200000
android_bootm_start=setenv android_stage bootm_start; run android_mark; \
	bootm start ${android_boot_addr} ${android_boot_addr} ${fdt_addr_r}
android_bootm_loados=setenv android_stage bootm_loados; run android_mark; bootm loados
android_bootm_ramdisk=setenv android_stage bootm_ramdisk; run android_mark; bootm ramdisk
# Android 接管 DWC3 前必须停用 U-Boot ACM gadget。
android_release_usb=setenv stdin serial,button-kbd && \
	setenv stdout serial && setenv stderr serial
android_booti_go=setexpr android_rd_len ${initrd_end} - ${initrd_start} && \
	setenv android_stage booti_go; run android_mark; \
	booti 0xa8000000 ${initrd_start}:${android_rd_len} ${fdt_addr_r}
android_booti=setexpr android_dtb_bootargs sub 'androidboot.slot_suffix=_b' 'androidboot.slot_suffix=_a' && \
	setenv bootargs ${android_dtb_bootargs} androidboot.slot_suffix=_a androidboot.boot_devices=${android_boot_devices} androidboot.bootdevice=${android_bootdevice} androidboot.fstab_suffix=${android_fstab_suffix} androidboot.dynamic_partitions=${android_dynamic_partitions} androidboot.verifiedbootstate=${android_verifiedbootstate} && \
	run android_bootm_start && run android_bootm_loados && \
	run android_bootm_ramdisk && run android_release_usb && run android_booti_go
android_handoff=run android_parse && run android_prepare_dtb && run android_booti

boot_android_a=if run android_config_load && run android_config_check && run android_find && run android_load; then \
	if run android_handoff; then echo Android handoff returned; \
	else echo Android handoff failed; fi; \
else echo Android A profile missing or incompatible; \
fi

boot_linux=for bootdev in 0 1 2 3 4 5 6 7; do if part number scsi ${bootdev} linux-boot bootpart; then if fatload scsi ${bootdev}:${bootpart} ${kernel_addr_r} /EFI/BOOT/BOOTAA64.EFI; then setenv stdout vidconsole,serial,usbacm; setenv stderr vidconsole,serial,usbacm; bootefi ${kernel_addr_r}; fi; fi; done
bootcmd=run menucmd; run boot_linux; reset
menucmd=setenv stdout vidconsole,serial,usbacm; \
	setenv stderr vidconsole,serial,usbacm; \
	setenv bootcmd run menucmd; bootmenu 5
bootmenu_0=Boot NixOS=run boot_linux; pause
bootmenu_1=Boot Android A directly (experimental)=run boot_android_a; pause
bootmenu_2=Drop to shell=setenv bootretry -1
bootmenu_3=Reset device=reset
button_cmd_0_name=Volume Down
button_cmd_0=run menucmd
