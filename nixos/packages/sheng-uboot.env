# SPDX-License-Identifier: GPL-2.0+
# Based on U-Boot v2026.10-rc5 board/qualcomm/qcom-phone.env.
bootdelay=0
bootretry=1
stdin=serial,button-kbd
stdout=vidconsole,serial
stderr=vidconsole,serial

# Bring up diagnostics before the UFS scan on this board without exposed UART.
serial_gadget=setenv stdin serial,button-kbd,usbacm; \
	setenv stdout vidconsole,serial,usbacm; \
	setenv stderr vidconsole,serial,usbacm; \
	setenv bootretry -1
preboot=run serial_gadget; scsi scan

# linux-boot is an outer GPT ESP, never Android super or a slot partition.
boot_linux=for bootdev in 0 1 2 3 4 5 6 7; do if part number scsi ${bootdev} linux-boot bootpart; then if fatload scsi ${bootdev}:${bootpart} ${kernel_addr_r} /EFI/BOOT/BOOTAA64.EFI; then bootefi ${kernel_addr_r}; fi; fi; done
bootcmd=run boot_linux; pause; run menucmd
menucmd=setenv bootcmd run menucmd; bootmenu -1
bootmenu_0=Boot NixOS=run boot_linux; pause
bootmenu_1=Enable USB serial console=run serial_gadget
bootmenu_2=Drop to shell=setenv bootretry -1
bootmenu_3=Reset device=reset
button_cmd_0_name=Volume Down
button_cmd_0=run menucmd
