From: DotRedstone <dotredstone@users.noreply.github.com>
Subject: [PATCH] arm64: dts: qcom: sheng: enable PM8550B HV haptics

The Xiaomi Pad 6S Pro uses the HAP525_HV block integrated in PM8550B.
Describe the calibration SDAM and the haptics peripheral using the values
from the stock sheng device tree.

diff --git a/arch/arm64/boot/dts/qcom/sm8550-xiaomi-sheng.dts b/arch/arm64/boot/dts/qcom/sm8550-xiaomi-sheng.dts
--- a/arch/arm64/boot/dts/qcom/sm8550-xiaomi-sheng.dts
+++ b/arch/arm64/boot/dts/qcom/sm8550-xiaomi-sheng.dts
@@ -8,0 +9 @@
+#include <dt-bindings/input/qcom,hv-haptics.h>
@@ -1409,0 +1411,22 @@
+&pm8550b {
+	pm8550b_haptics: haptics@f000 {
+		compatible = "qcom,hv-haptics";
+		reg = <0xf000>, <0xf100>, <0xf200>;
+		interrupts = <0x7 0xf0 0x1 IRQ_TYPE_EDGE_RISING>;
+		interrupt-names = "fifo-empty";
+		qcom,vmax-mv = <3600>;
+		qcom,brake-mode = <BRAKE_CLOSE_LOOP>;
+		qcom,brake-pattern = /bits/ 8 <0xff 0x3f 0x1f>;
+		qcom,lra-period-us = <6667>;
+		qcom,drv-sig-shape = <WF_SINE>;
+		qcom,brake-sig-shape = <WF_SINE>;
+		nvmem-names = "hap_cfg_sdam";
+		nvmem = <&pmk8550_sdam_9d00>;
+		status = "okay";
+
+		hap_swr_slave_reg: qcom,hap-swr-slave-reg {
+			regulator-name = "hap-swr-slave-reg";
+		};
+	};
+};
+
@@ -1420,0 +1443,7 @@
+&pmk8550 {
+	pmk8550_sdam_9d00: nvram@9d00 {
+		compatible = "qcom,spmi-sdam";
+		reg = <0x9d00>;
+	};
+};
+
